# 로컬 개발용 예시. `cp .env.example .env` 후 필요한 값만 바꿔서 사용.
# 실제 키·비밀번호는 .env 에만 넣고 절대 커밋하지 않는다.

NODE_ENV=development
# LOG_LEVEL=info

# --- DB (docker-compose.dev.yml 의 로컬 Postgres) ---
DATABASE_URL=postgresql://careerhub:careerhub@localhost:5432/careerhub?schema=public

# --- JWT (로컬은 아무 문자열이나 가능, 운영은 길고 무작위인 값) ---
JWT_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me

# --- 프론트엔드 주소 (CORS 허용 Origin 은 콤마로 여러 개 가능) ---
ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- AI (Groq) ---
# 비어 있으면 서버가 시작되지 않으므로 더미 값 유지. AI 기능을 쓰려면 실제 키로 교체.
GROQ_API_KEY=dummy-groq-key

# --- 이메일 (Resend) — 비밀번호 재설정 메일 ---
# 더미 값이면 메일 발송만 실패하고 나머지 기능은 동작.
RESEND_API_KEY=re_dummy
# RESEND_FROM_EMAIL=CareerHub <onboarding@resend.dev>

# --- SMS (Solapi) — 아이디 찾기 인증번호 ---
# 비워두면 문자 대신 서버 로그에 인증번호가 출력됨 (로컬 테스트용).
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=

# --- 이력서 업로드 (S3) ---
# 더미 값이면 이력서 업로드·다운로드만 실패. 실제 버킷을 쓰려면 AWS 자격 증명 필요.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=dummy-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
